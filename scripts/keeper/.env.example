# Copy to .env and fill in. .env is gitignored: never commit real values.
# The scripts read the environment, not the file: load it with  set -a; . ./.env; set +a
NEAR_NETWORK=testnet
NEAR_RPC=https://test.rpc.fastnear.com
# Flow keeper (npm run flows): the relay factory your vault was made by, and the keeper account.
FACTORY_ID=nf-relay-xxxx.testnet
KEEPER_ACCOUNT_ID=keeper-xxxx.testnet
# Hidden flows (npm run hidden): the vault's owner.
OWNER_ACCOUNT_ID=owner-xxxx.testnet
# Market keeper (npm run keeper) only.
MARKET_ID=market-xxxx.testnet
# Optional: otherwise the key is read from ~/.near-credentials/testnet/<KEEPER_ACCOUNT_ID>.json
# KEEPER_PRIVATE_KEY=ed25519:...
# Remote nodes (npm run flows -- --send --remote): one RPC per chain the keeper may broadcast to.
# None set: remote nodes are listed, nothing leaves NEAR.
# EVM_RPC_4663=https://rpc.mainnet.chain.robinhood.com
# EVM_RPC_8453=https://mainnet.base.org
# SOLANA_RPC=https://api.mainnet-beta.solana.com
# FLOWS_KEEPER_DIR=~/.flows/keeper      in-flight remote steps (never in the repo)
# REMOTE_SLIPPAGE_BPS=100   SOL_SLIPPAGE_PCT=5   REMOTE_WAIT_MIN=30   HOP_WAIT_MIN=180   HOP_BRIDGE=1
