{
  "about": "Ready-made flow nodes for the vault (contracts/vault). Each `recipe` is saved as a node's `action`; `${...}` are filled in by the canvas or the agent; `{amount}`, `{min_out}`, `{scaled}`, `{owner}`, `{vault}` are filled in by the vault at run time. `trust` lists what the vault must trust for the node to run. `tested` names the test that runs this recipe against real code, or says it isn't tested in a flow yet.",
  "network": "testnet",
  "nodes": [
    {
      "id": "wrap_near",
      "label": "Wrap NEAR",
      "protocol": "wNEAR",
      "input": "near",
      "output": "wrap.testnet",
      "trust": [
        {
          "contract": "wrap.testnet",
          "methods": [
            "near_deposit"
          ]
        }
      ],
      "recipe": {
        "label": "Wrap NEAR",
        "calls": [
          {
            "call": "fn",
            "contract": "wrap.testnet",
            "method": "near_deposit",
            "args": "{}",
            "deposit": {
              "kind": "input"
            },
            "tgas": 10
          }
        ],
        "out": "wrap.testnet",
        "min_out_per_in": null,
        "price": null
      },
      "tested": "sandbox/tests/protocols.rs near_is_wrapped_then_half_is_swapped_on_rhea (real wNEAR code)"
    },
    {
      "id": "rhea_swap",
      "label": "Swap on Rhea",
      "protocol": "Rhea DEX",
      "params": {
        "pool_id": "Rhea v1 pool id",
        "token_in": "input token",
        "token_out": "output token",
        "min_out_per_in": "least output per input, scaled 1e24 (slippage guard)"
      },
      "input": "${token_in}",
      "output": "${token_out}",
      "trust": [
        {
          "contract": "ref-finance-101.testnet",
          "methods": [
            "get_return"
          ]
        },
        {
          "contract": "${token_in}"
        },
        {
          "contract": "${token_out}"
        }
      ],
      "recipe": {
        "label": "Swap on Rhea",
        "calls": [
          {
            "call": "ft",
            "receiver": "ref-finance-101.testnet",
            "tgas": 120,
            "msg": "{\"force\":0,\"actions\":[{\"pool_id\":${pool_id},\"token_in\":\"${token_in}\",\"token_out\":\"${token_out}\",\"amount_in\":\"{amount}\",\"min_amount_out\":\"{min_out}\"}],\"skip_unwrap_near\":true}"
          }
        ],
        "out": "${token_out}",
        "min_out_per_in": "${min_out_per_in}",
        "price": {
          "contract": "ref-finance-101.testnet",
          "method": "get_return",
          "args": "{\"pool_id\":${pool_id},\"token_in\":\"${token_in}\",\"amount_in\":\"1000000000000000000000000\",\"token_out\":\"${token_out}\"}",
          "per": "1000000000000000000000000"
        }
      },
      "tested": "sandbox/tests/protocols.rs (swap, slippage refusal, price trigger; real Rhea code)."
    },
