    {
      "id": "rhea_borrow",
      "label": "Supply collateral and borrow on Rhea",
      "protocol": "Rhea lending",
      "params": {
        "collateral": "input token",
        "borrow_token": "token to borrow",
        "borrow_per_in": "how much to borrow per unit of collateral, scaled 1e24 (sets your loan-to-value)"
      },
      "input": "${collateral}",
      "output": "${borrow_token}",
      "trust": [
        {
          "contract": "contract.1689937928.burrow.testnet",
          "methods": [
            "execute_with_pyth"
          ]
        },
        {
          "contract": "${collateral}"
        },
        {
          "contract": "${borrow_token}"
        }
      ],
      "recipe": {
        "label": "Borrow on Rhea",
        "calls": [
          {
            "call": "ft",
            "receiver": "contract.1689937928.burrow.testnet",
            "tgas": 60,
            "msg": "{\"Execute\":{\"actions\":[{\"IncreaseCollateral\":{\"token_id\":\"${collateral}\",\"amount\":null,\"max_amount\":null}}]}}"
          },
          {
            "call": "fn",
            "contract": "contract.1689937928.burrow.testnet",
            "method": "execute_with_pyth",
            "deposit": {
              "kind": "one_yocto"
            },
            "tgas": 120,
            "args": "{\"actions\":[{\"Borrow\":{\"token_id\":\"${borrow_token}\",\"amount\":\"{scaled}\",\"max_amount\":null}},{\"Withdraw\":{\"token_id\":\"${borrow_token}\",\"amount\":null,\"max_amount\":\"{scaled}\"}}]}"
          }
        ],
        "out": "${borrow_token}",
        "min_out_per_in": null,
        "price": null,
        "scale_per_in": "${borrow_per_in}"
      },
      "warning": "All flows in one vault share one lending position: collateral from one flow backs loans of another. Show the vault's health once, above all flows.",
      "tested": "sandbox/tests/protocols.rs borrow_usdc_against_wnear_on_real_rhea_lending (testnet build v0.11, default prices)"
    },
    {
      "id": "rhea_repay",
      "label": "Repay on Rhea and take collateral back",
      "protocol": "Rhea lending",
      "params": {
        "debt_token": "input token",
        "collateral": "token to release",
        "release_per_in": "collateral released per unit repaid, scaled 1e24"
      },
      "input": "${debt_token}",
      "output": "${collateral}",
      "trust": [
        {
          "contract": "contract.1689937928.burrow.testnet",
          "methods": [
            "execute_with_pyth"
          ]
        },
        {
          "contract": "${debt_token}"
        },
        {
          "contract": "${collateral}"
        }
      ],
      "recipe": {
        "label": "Repay on Rhea",
        "calls": [
          {
            "call": "ft",
            "receiver": "contract.1689937928.burrow.testnet",
            "tgas": 60,
            "msg": "{\"Execute\":{\"actions\":[{\"Repay\":{\"token_id\":\"${debt_token}\",\"amount\":null,\"max_amount\":null}}]}}"
          },
          {
            "call": "fn",
            "contract": "contract.1689937928.burrow.testnet",
            "method": "execute_with_pyth",
            "deposit": {
              "kind": "one_yocto"
            },
            "tgas": 120,
            "args": "{\"actions\":[{\"DecreaseCollateral\":{\"token_id\":\"${collateral}\",\"amount\":\"{scaled}\",\"max_amount\":null}},{\"Withdraw\":{\"token_id\":\"${collateral}\",\"amount\":null,\"max_amount\":\"{scaled}\"}}]}"
          }
        ],
        "out": "${collateral}",
        "min_out_per_in": null,
        "price": null,
        "scale_per_in": "${release_per_in}"
      },
      "note": "The testnet build has no \"OnlyRepay\" message (mainnet does). Version-specific.",
      "tested": "sandbox/tests/protocols.rs borrow_usdc_against_wnear_on_real_rhea_lending (repay + release, and a refused repay that must not release)"
    },
